{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamastash/Qwen3.8-27B-Q8_0",
  "default_agent": "build-local",
  "providers": {
    "llamastash": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LlamaStash",
      "settings": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "MiniCPM5-2B-F16": {
          "name": "MiniCPM5 2B",
          "limit": {
            "context": 41100,
            "output": 2048
          }
        },
        "Qwen3-14B-Q4_K_M": {
          "name": "Qwen3 14B Q4_K_M"
        },
        "Qwen3.6-28B-REAP20-A3B-Q8_0": {
          "name": "Qwen3.6 28B REAP20 A3B Q8_0"
        },
        "Qwen3.8-27B-Q8_0": {
          "name": "Qwen3.8 27B Q8_0",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        },
        "gemma-4-21b-a4b-it-REAP-Q4_K_M": {
          "name": "Gemma 4 21B A4B IT REAP Q4_K_M"
        }
      }
    }
  },
  "agents": {
    "build-local": {
      "description": "Primary local implementation agent using the larger Qwen reasoning model.",
      "mode": "primary",
      "model": "llamastash/Qwen3.8-27B-Q8_0",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },
    "plan-local": {
      "description": "Local planning and shell-work agent using the smaller Qwen model.",
      "mode": "primary",
      "model": "llamastash/MiniCPM5-2B-F16",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },
    "shell-worker-local": {
      "description": "Bounded zsh/devops worker for safe command planning, repo inspection, reports, and dashboard rendering.",
      "mode": "subagent",
      "model": "llamastash/MiniCPM5-2B-F16",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },
    "explore-local": {
      "description": "Read-only repository exploration and summarization using the smaller Qwen model.",
      "mode": "subagent",
      "model": "llamastash/MiniCPM5-2B-F16",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },
    "review-local": {
      "description": "Higher-quality implementation review using the larger Qwen model.",
      "mode": "subagent",
      "model": "llamastash/Qwen3.8-27B-Q8_0",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "structurizr": {
        "type": "remote",
        "url": "http://127.0.0.1:3000/mcp",
        "oauth": false
      }
    }
  }
}
