
#### 'Go' codes ;-) 
alias goblue='sudo systemctl unmask bluetooth && sudo systemctl start bluetooth'
alias gocock='sudo systemctl start cockpit.socket'
alias gocups='sudo systemctl start ahavi-daemon && sudo systemctl start cups'
alias goinc='sudo systemctl start incus.socket && sudo systemctl start incus'
alias goram='sudo mount -t ramfs -o size=512m ramfs $HOME/working/ramdisk && sudo chown -R `whoami`:`whoami` $HOME/working/ramdisk'
alias gostash='systemctl --user start llamastash-tunnel'

#### 'No' codes :-(
alias noblue='sudo systemctl stop bluetooth && sudo systemctl mask bluetooth'
alias nocock='sudo systemctl stop cockpit.socket'
alias nopram='sudo umount `pwd`/ramdisk'

#### 'set' commands
alias set-gpg-agent='export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket) && echo "Using GPG SSH agent"'
alias set-ansible-agent='start_ansible_agent && export SSH_AUTH_SOCK=$ANSIBLE_SSH_AUTH_SOCK && echo "Using Ansible SSH agent"'

### 'get' commands
alias get-agent-stat='echo "Active SSH agent: $SSH_AUTH_SOCK"; ssh-add -l'

