[commit]
	gpgsign = true
[gpg]
	program = /usr/bin/gpg
[init]
	defaultBranch = main
[user]
	name = elliottgreen
	email = omar.elliottgreen@gmail.com
	signingkey = 0x232BE2332A2095F8A6226AD9334C2DABEB2A6CF1
	useConfigOnly = true
[credential]
	helper = cache
[status]
	ShowUntrackedFiles = no
[core]
	editor = nvim
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
