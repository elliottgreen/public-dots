#compdef vd visidata

# Local workaround for VisiData 3.4 zsh completion generation; remove after an
# upstream release escapes apostrophes in option help text.

(( $+functions[_vd_files] )) ||
_vd_files () {
  case $PREFIX in
    (*) _files $* ;;
  esac
  case $PREFIX in
    (+) _message -e 'toplevel:subsheet:col:row' ;;
    (+<1->) _message -e 'toplevel' ;;
    (+<1->:) _message -e 'subsheet' ;;
    (+<1->:<1->:) _message -e 'col' ;;
    (+<1->:<1->:<1->:) _message -e 'row' ;;
  esac
}

